# Copy this file to .env.local for local development.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Prefer the current publishable key. NEXT_PUBLIC_SUPABASE_ANON_KEY remains supported for legacy projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional shared rate limiting for multi-instance production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe — leave empty to use mock mode (dev / staging). For production:
# 1. Create Stripe products matching each `packages` row in Supabase
# 2. Set the four variables below
# 3. Configure webhook endpoint at https://your-domain.com/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=HKD

# Notification providers — both default to off (logs + Supabase audit only).
# Set NOTIFY_DRY_RUN=0 to actually call external providers.
NOTIFY_DRY_RUN=1
NOTIFY_WHATSAPP_PROVIDER=off
NOTIFY_EMAIL_PROVIDER=off
